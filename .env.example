# App Configuration
APP_NAME="GeM Bid Compliance Verification Platform"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=gem-compliance-super-secret-key-change-in-production

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gem_compliance
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/gem_compliance
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/gem_compliance

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
