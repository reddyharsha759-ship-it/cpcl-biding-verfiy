# App Configuration
APP_NAME="GeM Bid Compliance Verification Platform"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=gem-compliance-super-secret-key-change-in-production

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gem_compliance
DATABASE_URL=sqlite+aiosqlite:///./gem_compliance.db
SYNC_DATABASE_URL=sqlite:///./gem_compliance.db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
